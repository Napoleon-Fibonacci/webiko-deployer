# Neon Postgres (Vercel Marketplace -> Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Token API Vercel (server only). Buat di https://vercel.com/account/tokens
VERCEL_TOKEN=

# Opsional: isi kalau project berada di dalam team
VERCEL_TEAM_ID=

# Vercel Blob (Vercel Storage -> Blob). Dipakai upload ZIP dari browser.
BLOB_READ_WRITE_TOKEN=

# Batas jumlah project aktif
MAX_PROJECTS=180

# Umur situs dalam hari. Lewat dari ini, cron harian menghapus project-nya.
SITE_TTL_DAYS=7

# Kuota per browser dan umur minimum sebelum situs orang lain boleh digeser.
MAX_SITES_PER_OWNER=2
MIN_EVICT_HOURS=24

# Batas deploy server per 24 jam bergulir. 0 = tanpa batas.
MAX_DEPLOYS_PER_DAY=40

# Opsional. Kalau diisi, deploy wajib menyertakan kode ini. Berguna sebagai
# kill switch saat kuota Vercel menipis. Kosong = deploy publik.
DEPLOY_ACCESS_CODE=

# Opsional. Kunci tanda tangan cookie pemilik browser. Kalau kosong, server
# memakai ADMIN_PASSWORD/CRON_SECRET/VERCEL_TOKEN yang sudah ada.
OWNER_COOKIE_SECRET=

# Rahasia cron pembersih. Isi dengan string acak; kalau diisi, Vercel
# menyertakan header Authorization: Bearer <CRON_SECRET> saat memanggil cron.
# Kosong = hanya sesi admin yang boleh memicu /api/cron/cleanup.
CRON_SECRET=

# URL publik situs. Dipakai untuk og:image, canonical, sitemap, dan cookie.
# Di Vercel boleh kosong: otomatis memakai VERCEL_PROJECT_PRODUCTION_URL.
SITE_URL=

# Password menu admin (/admin). Kosong = menu admin nonaktif.
ADMIN_PASSWORD=

# Opsional: banner donasi kunci API Vercel di halaman depan. Formulir menyimpan
# kunci sebagai pending terenkripsi + meneruskan ke bot Telegram pemilik.
# Isi keduanya untuk mengaktifkan; kosong = banner tidak tampil.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kunci enkripsi pool kunci API Vercel yang didonasikan. Kosong = fallback ke
# rahasia server yang sudah ada (OWNER_COOKIE_SECRET dst.).
POOL_SECRET=
